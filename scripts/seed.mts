/**
 * The home-page rail. Created in the shipped order, so a card left without a
 * photograph still falls back to the shipped card in the same position.
 */
async function seedProjects(payload: Payload) {
  for (const [index, slide] of siteContent.gallery.slides.entries()) {
    const cardImage = await media(payload, slide.image);
    const { docs } = await payload.find({
      collection: "projects",
      where: { slug: { equals: slide.id } },
      limit: 1,
      depth: 0,
    });
    const existing = docs[0];

    if (!existing) {
      await payload.create({
        collection: "projects",
        data: {
          name: slide.name,
          locality: slide.locality,
          status: slide.status,
          order: index + 1,
          slug: slide.id,
          blurb: slide.blurb,
          cardImage,
        },
        context: context(),
      });
      console.log(
        `  projects/${slide.id}: created${cardImage === undefined ? " (no card image)" : ""}`,
      );
    } else if (!existing.cardImage && cardImage !== undefined) {
      await payload.update({
        collection: "projects",
        id: existing.id,
        data: { cardImage },
        context: context(),
      });
      console.log(`  projects/${slide.id}: card image filled`);
    }
  }
}

/**
 * The shipped articles. Publishing the first one makes the collection the
 * only source for /blogs (lib/getBlogPosts.ts), so all of them go in together.
 */
async function seedPosts(payload: Payload) {
  for (const post of blogPosts) {
    const { totalDocs } = await payload.count({
      collection: "posts",
      where: { slug: { equals: post.slug } },
    });
    if (totalDocs > 0) continue;

    const image =
      (await media(payload, post.image)) ??
      (await upload(
        payload,
        fileOf(post.image.src),
        post.image.alt,
        `placeholder-${post.slug}`,
      ));

    await payload.create({
      collection: "posts",
      draft: false,
      data: {
        title: post.title,
        slug: post.slug,
        swashTitle: post.swashTitle,
        category: post.category,
        readingTime: post.readingTime,
        publishedAt: istMidnight(post.date),
        excerpt: post.excerpt,
        image,
        sections: post.body.map((clause) => ({
          heading: clause.heading,
          body: clause.body?.map((text) => ({ text })),
          list: clause.list?.map((text) => ({ text })),
        })),
        _status: "published",
      },
      context: context(),
    });
    console.log(`  posts/${post.slug}: published`);
  }
}

