const IMAGES = path.resolve(import.meta.dirname, "../public/images");
const LONG_EDGE = 2560;
/**
 * A FRESH context object per call — never one shared object.
 *
 * Payload passes this straight through to `req.context` BY REFERENCE when the
 * local API is called without a `req` (createLocalReq → getRequestContext), so
 * anything a hook writes onto it outlives the call that made it. The cloud
 * storage plugin writes two such keys: `_payloadCloudStorage`, and
 * `skipCloudStorage`, which it sets around its own nested `payload.update` and
 * then deletes from the WRONG object — that nested call replaced `req.context`
 * with a copy, so the delete never reaches the caller's.
 *
 * Share one object across calls and the leftover `skipCloudStorage: true` makes
 * the plugin's afterChange hook return early for the rest of the process: every
 * upload after the first is skipped in silence, the Media row is still written
 * with a Cloudinary URL, and nothing ever reaches Cloudinary. That is exactly
 * what the 17 September seed did — 1 of 28 files uploaded, success reported.
 * scripts/repair-cloudinary.mts cleans up after it.
 */
const context = () => ({ disableRevalidate: true });

/* ------------------------------------------------------------- the files */

/** Generated by scripts/make-placeholders.mjs: navy plates, not photographs. */
const PLACEHOLDERS = new Set([
  "concept.jpg",
  "projects/bkc-32.jpg",
  "projects/parijat.jpg",
  "projects/residency.jpg",
  "projects/royale.jpg",
]);

/** Paths the shipped content uses for a file that lives elsewhere. */
const ALIASES: Record<string, string> = {
  "hero/bkc-28.png": "projects/bkc-28.jpg",
  "projects/godrej-skygarden.jpg": "jv/skygardens.png",
};

/**
 * An upload carries one alt text wherever it is used. By default it is the alt
 * of the first place the file is met, in the order below (Home first); these
 * are the files whose shipped alts disagree, or have none.
 */
