  // Journey sets the hero as decoration (alt=""), but a Media document needs
  // one; this describes what the pins are placed on.
  "mainheroimage.png":
    "A rooftop terrace at dusk: an open pavilion, lounge seating and loungers along an infinity pool, with the lit city beyond the parapet",
  "jv/skygardens.png":
