  "maps.png":
    "Map of the Mumbai metropolitan region, from Mira Bhayandar south to the island city and east through Thane to Badlapur",
};

/** Flat colour and fine type: JPEG would smear the map's lettering. */
const KEEP_PNG = new Set(["maps.png"]);

/**
 * The site-wide share card. It was the last image on the site still read from
 * the repository rather than from an upload: every page that sets no card of
 * its own now falls back to the Home global's, which is this, uploaded once.
 */
const SHARE_CARD: ImageAsset = {
  src: "/images/og.jpg",
  alt: "Vakratunda Group — where dreams find an address",
  width: 1200,
  height: 630,
};

/* ------------------------------------------------------------- uploading */

const uploaded = new Map<string, number>();
const report = {
  uploaded: [] as string[],
  reused: [] as string[],
  placeholders: new Set<string>(),
  missing: new Set<string>(),
};

function fileOf(src: string): string {
  const file = src.replace(/^\/images\//, "");
  return ALIASES[file] ?? file;
}

async function upload(
  payload: Payload,
  file: string,
  alt: string,
  name?: string,
): Promise<number> {
  const input = await readFile(path.join(IMAGES, file));
  const [meta, stats] = await Promise.all([
    sharp(input).metadata(),
    sharp(input).stats(),
  ]);
  const png = KEEP_PNG.has(file) || (Boolean(meta.hasAlpha) && !stats.isOpaque);
  const base = name ?? path.basename(file).replace(/\.[^.]+$/, "").toLowerCase();
  const filename = `${base}.${png ? "png" : "jpg"}`;

  const existing = await payload.find({
    collection: "media",
    where: { filename: { equals: filename } },
    limit: 1,
    depth: 0,
  });
  if (existing.docs[0]) {
    report.reused.push(filename);
    return existing.docs[0].id;
  }

  const resized = sharp(input).rotate().resize({
    width: LONG_EDGE,
    height: LONG_EDGE,
    fit: "inside",
    withoutEnlargement: true,
  });
  const data = png
    ? await resized.png({ compressionLevel: 9 }).toBuffer()
    : await resized.jpeg({ quality: 86, mozjpeg: true }).toBuffer();

  const doc = await payload.create({
    collection: "media",
    data: { alt },
    file: {
      data,
      mimetype: png ? "image/png" : "image/jpeg",
      name: filename,
      size: data.length,
    },
    context: context(),
  });
  report.uploaded.push(`${filename} (${(data.length / 1048576).toFixed(1)} MB)`);
  return doc.id;
}

/** The upload standing in for a shipped image, or undefined where there is none to give. */
async function media(
  payload: Payload,
  asset: ImageAsset | undefined,
): Promise<number | undefined> {
  if (!asset?.src) return undefined;
  const file = fileOf(asset.src);
  if (PLACEHOLDERS.has(file)) {
    report.placeholders.add(file);
    return undefined;
  }
  if (!existsSync(path.join(IMAGES, file))) {
    report.missing.add(file);
    return undefined;
  }
  if (!uploaded.has(file)) {
    uploaded.set(file, await upload(payload, file, ALT[file] ?? asset.alt));
  }
  return uploaded.get(file);
}

/* --------------------------------------------------------------- filling */

type Json = Record<string, unknown>;

/**
 * Whether a spot in a global is still untouched.
 *
 * DEEP, and that is what lets a whole section be seeded in one entry. Payload
 * returns an unfilled group as an object of nulls and empty arrays rather than
 * as nothing at all, so a shallow check would call every group "already
 * filled" and this script would never write a word. A group is empty when
 * everything in it is; one line typed into it makes the whole group somebody's
 * work, and it is left alone.
 *
 * A boolean is never empty — `false` is an answer. That is why the SEO tab is
 * seeded field by field: `noIndex` defaults to `false` and would otherwise
 * hold the whole tab open.
 */
function isEmpty(value: unknown): boolean {
  if (value === null || value === undefined) return true;
  if (typeof value === "string") return value.trim() === "";
  if (Array.isArray(value)) return value.length === 0;
  if (typeof value === "object") return Object.values(value).every(isEmpty);
  return false;
}

/** Sets `value` at a dotted path, unless the path already holds something. */
function fill(doc: Json, dotted: string, value: unknown): boolean {
  if (isEmpty(value)) return false;
  const keys = dotted.split(".");
  let node = doc;
  for (const key of keys.slice(0, -1)) {
    if (typeof node[key] !== "object" || node[key] === null) node[key] = {};
    node = node[key] as Json;
  }
  const last = keys[keys.length - 1]!;
  if (!isEmpty(node[last])) return false;
  node[last] = value;
  return true;
}

/**
 * Fills the empty spots in a global. The whole document is read at depth 0
 * and written back, so every field this script does not touch is saved as it
 * was.
 */
async function fillGlobal(
  payload: Payload,
  slug: GlobalSlug,
  entries: [string, unknown][],
): Promise<void> {
  const data = {
    ...((await payload.findGlobal({ slug, depth: 0 })) as unknown as Json),
  };
  const filled = entries
    .filter(([dotted, value]) => fill(data, dotted, value))
    .map(([dotted]) => dotted);
  if (filled.length === 0) {
    console.log(`  ${slug}: nothing empty to fill`);
    return;
  }
  for (const key of ["id", "createdAt", "updatedAt", "globalType"]) {
    delete data[key];
  }
  await payload.updateGlobal({ slug, data: data as never, depth: 0, context: context() });
  console.log(`  ${slug}: ${filled.length} filled — ${filled.join(", ")}`);
}

/** A list of rows, dropping any whose photograph there is none to give for. */
async function rowsOf<T>(
  items: T[],
  row: (item: T) => Promise<Json | undefined>,
): Promise<Json[]> {
  const out: Json[] = [];
  for (const item of items) {
    const value = await row(item);
    if (value) out.push(value);
  }
  return out;
}

/* ------------------------------------------------------------ converters
   One per builder in fields/pageFields.ts, turning a shipped shape into the
   rows Payload stores it as. Each is the inverse of the matching merge in
   lib/cms/shapes.ts, so what goes in comes back out unchanged — which is the
   property that makes seeding invisible on the page. */

/** A repeatable plain-text field: ["a", "b"] → [{ text: "a" }, { text: "b" }]. */
const linesOf = (values: string[] | undefined): Json[] =>
  (values ?? []).map((text) => ({ text }));

/** The three-part headline. */
const swashOf = (h: SwashHeading): Json => ({
  before: h.before ?? null,
  swash: h.swash,
  after: h.after ?? null,
});

const ctaOf = (cta: Cta | undefined): Json | undefined =>
  cta ? { label: cta.label, href: cta.href } : undefined;

const heroOf = (hero: PageHeroContent): Json => ({
  label: hero.label,
  heading: swashOf(hero.heading),
  standfirst: hero.standfirst,
  meta: linesOf(hero.meta),
});

const cardsOf = (items: CardItem[]): Json[] =>
  items.map((item) => ({
    icon: item.icon ?? null,
    eyebrow: item.eyebrow ?? null,
    title: item.title,
    body: item.body,
  }));

const entriesOf = (entries: LedgerEntry[]): Json[] =>
  entries.map((entry) => ({
    meta: entry.meta,
    title: entry.title,
    note: entry.note ?? null,
    href: entry.href ?? null,
    action: entry.action ?? null,
    state: entry.state ?? null,
  }));

const statsOf = (stats: Stat[]): Json[] =>
  stats.map((stat) => ({
    value: stat.value,
    suffix: stat.suffix ?? null,
    unit: stat.unit ?? null,
    note: stat.note,
  }));

const faqsOf = (items: FaqItem[]): Json[] =>
  items.map((item) => ({
    question: item.question,
    answer: linesOf(item.answer),
  }));

const clausesOf = (clauses: ProseClause[]): Json[] =>
  clauses.map((clause) => ({
    heading: clause.heading,
    body: linesOf(clause.body),
    list: linesOf(clause.list),
  }));

/** A section head + its cards, as `cardSection()` stores them. */
const cardSectionOf = (section: {
  label?: string;
  heading: SwashHeading;
  standfirst?: string;
  lead?: string;
  items: CardItem[];
}): Json => ({
  ...(section.label === undefined ? {} : { label: section.label }),
  heading: swashOf(section.heading),
  ...(section.lead === undefined
    ? { standfirst: section.standfirst }
    : { lead: section.lead }),
  items: cardsOf(section.items),
});

/** A section head + its rows, as `ledgerSection()` stores them. */
const ledgerSectionOf = (band: {
  label?: string;
  heading: SwashHeading;
  standfirst: string;
  entries: LedgerEntry[];
  note?: string;
}): Json => ({
  ...(band.label === undefined ? {} : { label: band.label }),
  heading: swashOf(band.heading),
  standfirst: band.standfirst,
  entries: entriesOf(band.entries),
  ...(band.note === undefined ? {} : { note: band.note }),
});

const MONTHS = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

/** "12 August 2025" → midnight that day in Mumbai, which is how the site reads it back. */
function istMidnight(value: string): string {
  const [day, month, year] = value.split(" ");
  const utc = Date.UTC(Number(year), MONTHS.indexOf(month!), Number(day));
  return new Date(utc - 5.5 * 60 * 60 * 1000).toISOString();
}

const docOf = (doc: ProseDoc): Json => ({
  updated: istMidnight(doc.updated),
  intro: linesOf(doc.intro),
  clauses: clausesOf(doc.clauses),
  closing: doc.closing ?? null,
  cta: ctaOf(doc.cta) ?? null,
});

/** The SEO tab, field by field — see the note in `isEmpty` about `noIndex`. */
const seoEntries = (seo: SeoContent): [string, unknown][] => [
  ["seo.title", seo.title],
  ["seo.description", seo.description],
];

